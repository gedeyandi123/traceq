{
  "name": "traceq-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "openapi": "uv run --no-sync --offline --project .. python -m traceq.app.api openapi.json && uv run --no-sync --offline --project .. python -m traceq_eval.screen openapi eval-openapi.json",
    "generate": "openapi-typescript openapi.json -o src/api/schema.ts && openapi-typescript eval-openapi.json -o src/api/eval-schema.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "lucide-react": "^1.79.0",
    "next": "16.4.6",
    "next-intl": "4.15.1",
    "openapi-fetch": "0.17.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/parser": "^8.74.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "31.0.1",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "^4.3.5",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
