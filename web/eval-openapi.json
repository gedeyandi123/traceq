{
  "openapi": "3.1.0",
  "info": {
    "title": "TraceQ eval",
    "summary": "Read-only aggregates of scored runs.",
    "version": "0.1.0"
  },
  "paths": {
    "/evals": {
      "get": {
        "summary": "List Evals",
        "description": "Every scored run, newest run id first.",
        "operationId": "listEvals",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/EvalSummary"
                  },
                  "type": "array",
                  "title": "Response Listevals"
                }
              }
            }
          }
        }
      }
    },
    "/evals/{run_id}": {
      "get": {
        "summary": "Get Eval",
        "operationId": "getEval",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvalSummary"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EvalSummary": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "equipment": {
            "type": "string",
            "title": "Equipment"
          },
          "split": {
            "type": "string",
            "enum": [
              "dev",
              "held_out"
            ],
            "title": "Split"
          },
          "scorer_version": {
            "type": "string",
            "title": "Scorer Version"
          },
          "gates_passed": {
            "type": "boolean",
            "title": "Gates Passed"
          },
          "rates": {
            "items": {
              "$ref": "#/components/schemas/Rate"
            },
            "type": "array",
            "title": "Rates"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "mode": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "replay",
                  "live"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Mode"
          },
          "cost_usd": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cost Usd"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "run_id",
          "equipment",
          "split",
          "scorer_version",
          "gates_passed",
          "rates",
          "model",
          "mode",
          "cost_usd"
        ],
        "title": "EvalSummary",
        "description": "One scored run, as aggregates."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Rate": {
        "properties": {
          "metric": {
            "type": "string",
            "title": "Metric"
          },
          "k": {
            "type": "integer",
            "title": "K"
          },
          "n": {
            "type": "integer",
            "title": "N"
          },
          "rate": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rate"
          },
          "better": {
            "type": "string",
            "enum": [
              "higher",
              "lower"
            ],
            "title": "Better"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "metric",
          "k",
          "n",
          "rate",
          "better"
        ],
        "title": "Rate"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
