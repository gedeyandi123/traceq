  "displayName": "TraceQ Reference IdP",
  "accessTokenLifespan": 3600,
  "ssoSessionIdleTimeout": 3600,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "qualification-decider",
        "description": "Decides matrix proposals and assembles protocols"
      },
      {
        "name": "qualification-approver",
        "description": "Approves or returns protocols, closes deviations, approves qualification reports"
      },
      {
        "name": "qualification-executor",
        "description": "Executes approved protocols and records test step attempts"
      },
      {
        "name": "qualification-witness",
        "description": "Confirms execution results as a witness"
      }
    ]
  },
