# Private denylist terms (see scripts/check_denylist.py)
.denylist.local

# Secrets
.env
.env.*
!.env.example

# Rendered corpus: published as GitHub Release assets, never committed
/dist/
/build/

# Claude Code subagent worktrees (isolation: worktree)
/.claude/worktrees/

# Python
__pycache__/
*.py[cod]
.venv/
.ruff_cache/
.pytest_cache/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# gitleaks binary downloaded in CI
/gitleaks

# Run folders written by `traceq run` (recordings are committed; runs are not)
/runs/

# Web UI (web/): dependencies and build output
node_modules/
/web/.next/
/web/next-env.d.ts
*.tsbuildinfo
